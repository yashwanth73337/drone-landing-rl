<?xml version="1.0"?>
<!-- V5 LMF2 quad, pre-merged into a single link. Source: AerialGym
     resources/robots/lmf2/model.urdf, i.e. a 1.2 kg base with diag(0.013, 0.014, 0.013)
     plus 4 x 0.01 kg props at (+-0.1, +-0.1, 0). Merged: mass 1.24 kg,
     inertia diag(0.0134, 0.0144, 0.0138). Merged by hand (not with
     URDF_MERGE_FIXED_LINKS) so the inertia is exact and PyBullet prints nothing.
     Must match envs/lmf2_params.py (checked by the tests). -->
<robot name="lmf2">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.24"/>
      <inertia ixx="0.0134" ixy="0" ixz="0" iyy="0.0144" iyz="0" izz="0.0138"/>
    </inertial>
    <visual><geometry><box size="0.25 0.25 0.06"/></geometry></visual>
    <collision><geometry><box size="0.5 0.5 0.5"/></geometry></collision>
  </link>
</robot>
