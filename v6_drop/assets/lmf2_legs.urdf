<?xml version="1.0"?>
<!-- v6 LMF2 with landing legs (proposal). Mass and inertia unchanged from V5 lmf2.urdf.
     Body 0.25 x 0.25 x 0.06 m; motors at (+-0.1, +-0.1); 4 legs straight down under the
     motors; feet 0.14 m below the body centre. -->
<robot name="lmf2_legs">
  <material name="body"><color rgba="0.15 0.15 0.18 1"/></material>
  <material name="arm"><color rgba="0.3 0.3 0.33 1"/></material>
  <material name="prop"><color rgba="0.2 0.5 0.9 0.6"/></material>
  <material name="leg"><color rgba="0.85 0.45 0.1 1"/></material>
  <link name="base_link">
    <inertial><origin xyz="0 0 0"/><mass value="1.24"/>
      <inertia ixx="0.0134" ixy="0" ixz="0" iyy="0.0144" iyz="0" izz="0.0138"/></inertial>
    <visual><geometry><box size="0.16 0.16 0.06"/></geometry><material name="body"/></visual>
    <visual><origin xyz="0 0 0.01" rpy="0 0 0.7854"/><geometry><box size="0.30 0.025 0.02"/></geometry><material name="arm"/></visual>
    <visual><origin xyz="0 0 0.01" rpy="0 0 -0.7854"/><geometry><box size="0.30 0.025 0.02"/></geometry><material name="arm"/></visual>
    <visual><origin xyz="0.1 0.1 0.03"/><geometry><cylinder radius="0.06" length="0.005"/></geometry><material name="prop"/></visual>
    <visual><origin xyz="0.1 -0.1 0.03"/><geometry><cylinder radius="0.06" length="0.005"/></geometry><material name="prop"/></visual>
    <visual><origin xyz="-0.1 0.1 0.03"/><geometry><cylinder radius="0.06" length="0.005"/></geometry><material name="prop"/></visual>
    <visual><origin xyz="-0.1 -0.1 0.03"/><geometry><cylinder radius="0.06" length="0.005"/></geometry><material name="prop"/></visual>
    <visual><origin xyz="0.1 0.1 -0.08"/><geometry><cylinder radius="0.006" length="0.12"/></geometry><material name="leg"/></visual>
    <visual><origin xyz="0.1 -0.1 -0.08"/><geometry><cylinder radius="0.006" length="0.12"/></geometry><material name="leg"/></visual>
    <visual><origin xyz="-0.1 0.1 -0.08"/><geometry><cylinder radius="0.006" length="0.12"/></geometry><material name="leg"/></visual>
    <visual><origin xyz="-0.1 -0.1 -0.08"/><geometry><cylinder radius="0.006" length="0.12"/></geometry><material name="leg"/></visual>
    <visual><origin xyz="0.1 0.1 -0.14"/><geometry><sphere radius="0.012"/></geometry><material name="leg"/></visual>
    <visual><origin xyz="0.1 -0.1 -0.14"/><geometry><sphere radius="0.012"/></geometry><material name="leg"/></visual>
    <visual><origin xyz="-0.1 0.1 -0.14"/><geometry><sphere radius="0.012"/></geometry><material name="leg"/></visual>
    <visual><origin xyz="-0.1 -0.1 -0.14"/><geometry><sphere radius="0.012"/></geometry><material name="leg"/></visual>
    <collision><geometry><box size="0.16 0.16 0.06"/></geometry></collision>
    <collision><origin xyz="0 0 0.01" rpy="0 0 0.7854"/><geometry><box size="0.30 0.025 0.02"/></geometry></collision>
    <collision><origin xyz="0 0 0.01" rpy="0 0 -0.7854"/><geometry><box size="0.30 0.025 0.02"/></geometry></collision>
    <collision><origin xyz="0.1 0.1 -0.08"/><geometry><cylinder radius="0.006" length="0.12"/></geometry></collision>
    <collision><origin xyz="0.1 -0.1 -0.08"/><geometry><cylinder radius="0.006" length="0.12"/></geometry></collision>
    <collision><origin xyz="-0.1 0.1 -0.08"/><geometry><cylinder radius="0.006" length="0.12"/></geometry></collision>
    <collision><origin xyz="-0.1 -0.1 -0.08"/><geometry><cylinder radius="0.006" length="0.12"/></geometry></collision>
    <collision><origin xyz="0.1 0.1 -0.14"/><geometry><sphere radius="0.012"/></geometry></collision>
    <collision><origin xyz="0.1 -0.1 -0.14"/><geometry><sphere radius="0.012"/></geometry></collision>
    <collision><origin xyz="-0.1 0.1 -0.14"/><geometry><sphere radius="0.012"/></geometry></collision>
    <collision><origin xyz="-0.1 -0.1 -0.14"/><geometry><sphere radius="0.012"/></geometry></collision>
  </link>
</robot>
